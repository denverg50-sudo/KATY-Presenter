        "items": [
          {
            "style": "top:0",
            "lines": [
              {
                "align": "",
                "text": [
                  {
                    "value": "Twas grace that taught my heart to fear",
                    "style": ""
                  }
                ]
              },
              {
                "align": "",
                "text": [
                  {
                    "value": "And grace my fears relieved",
                    "style": ""
